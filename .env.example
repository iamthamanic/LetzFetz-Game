# Dev server port (default: 4789)
VITE_DEV_PORT=4789

# Optional — Meshy text→3D for `npm run asset:model -- <id> --provider=meshy`
# and VFX Studio worker (`npm run vfx-worker`). Server-side only — never VITE_*.
# Never commit real keys. Opt-in flag required; fail closed without key.
# MESHY_API_KEY=

# Optional — VFX worker port (default 8787)
# VFX_WORKER_PORT=8787
