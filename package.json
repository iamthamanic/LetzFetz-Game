      "scripts": {
            "dev": "vite",
            "build": "vite build",
            "test": "vitest run",
            "test:watch": "vitest",
            "checks": "npm run build && npm test && npm run check:v6-formula-recipes && npm run check:v6-v5-isolation && npm run fallow",
            "typecheck": "tsc -p tsconfig.app.json --noEmit",
            "lint": "biome check src/game/engine/v6 src/content/v6 src/generated/v6 src/game/packs/v6 src/features/play/board/V6FormulaActivationPreview.tsx src/features/play/presentation/v6FormulaPlanPreview.ts src/features/play/presentation/v6FormulaPlanPreview.test.ts src/features/play/setup/v6PlayableFlag.ts src/features/play/setup/v6SetupSmoke.test.ts src/features/play/setup/resolveGamePackChoice.ts src/components/ui/Panel.tsx",
            "lint:fix": "npm run lint -- --write",
            "fallow": "fallow -c fallow.jsonc --format json -o .qa/evidence/fallow-latest.json --fail-on-regression --regression-baseline .qa/fallow-regression.baseline.json",
            "fallow:report": "fallow -c fallow.jsonc --format human",
            "generate:v6-formula-recipes": "npx tsx scripts/generate-v6-formula-recipes.ts",
            "check:v6-formula-recipes": "npm run generate:v6-formula-recipes && git diff --exit-code -- src/generated/v6/formulaRecipes.generated.ts",
            "check:v6-v5-isolation": "bash scripts/check-v6-v5-isolation.sh",
            "audio:help": "bash tools/audio-forge/bin/run.sh help",
            "audio:generate": "bash tools/audio-forge/bin/run.sh generate",
            "audio:audit": "bash tools/audio-forge/bin/run.sh audit",
            "audio:plan": "bash tools/audio-forge/bin/run.sh plan",
            "audio:process": "bash tools/audio-forge/bin/run.sh process",
            "audio:review": "bash tools/audio-forge/bin/run.sh review",
            "audio:verify": "bash tools/audio-forge/bin/run.sh verify",
            "audio:test": "bash tools/audio-forge/bin/test.sh",
            "test:e2e": "playwright test",
            "test:e2e:ui": "playwright test --ui",
            "test:e2e:v5": "playwright test e2e/v5-e2e-verify-ui.spec.ts",
            "test:e2e:v6": "playwright test e2e/v6-setup-flag.spec.ts",
            "test:e2e:visual-mvp": "playwright test e2e/fetz-3d-visual-regression-mvp.spec.ts",
            "test:e2e:visual-mvp:update": "playwright test e2e/fetz-3d-visual-regression-mvp.spec.ts --update-snapshots",
            "test:e2e:mobile-perf": "playwright test e2e/fetz-3d-mobile-perf.spec.ts",
            "generate:mvp-engine-glbs": "npx tsx scripts/generate-mvp-placeholder-glbs.ts --all",
            "generate:engine-part-glbs": "npx tsx scripts/generate-mvp-placeholder-glbs.ts",
            "generate:pilot-engine-glbs": "npx tsx scripts/generate-pilot-real-glbs.ts",
            "generate:batch-a-engine-glbs": "npx tsx scripts/generate-batch-a-glbs.ts",
            "generate:batch-b-engine-glbs": "npx tsx scripts/generate-batch-glbs.ts --batch=B",
            "generate:batch-c-engine-glbs": "npx tsx scripts/generate-batch-glbs.ts --batch=C",
            "asset:validate": "node tools/asset-pipeline/validate.mjs",
            "asset:preview": "node tools/asset-pipeline/preview.mjs",
            "asset:all": "node tools/asset-pipeline/all.mjs",
            "asset:blender": "node tools/blender/run.mjs",
            "asset:spec": "node tools/asset-pipeline/stub.mjs spec",
            "asset:concept": "node tools/asset-pipeline/stub.mjs concept",
            "asset:multiview": "node tools/asset-pipeline/stub.mjs multiview",
            "asset:model": "node tools/asset-pipeline/model.mjs",
            "asset:normalize": "node tools/asset-pipeline/normalize.mjs",
            "asset:optimize": "node tools/asset-pipeline/optimize.mjs",
            "asset:publish": "node tools/asset-pipeline/stub.mjs publish",
            "assets:validate": "node tools/asset-pipeline/stub.mjs assets-validate",
            "assets:previews": "node tools/asset-pipeline/stub.mjs assets-previews",
            "assets:registry": "node tools/asset-pipeline/stub.mjs assets-registry",
            "assets:report": "node tools/asset-pipeline/stub.mjs assets-report",
            "generate:card-art": "npx tsx scripts/generate-base-pack-art.ts",
            "generate:element-effect-art": "npx tsx scripts/generate-element-effect-art.ts",
            "generate:higgsfield-chars": "npx tsx scripts/generate-higgsfield-characters.ts",
